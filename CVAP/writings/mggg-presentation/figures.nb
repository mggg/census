               RowBox[{"vars", ",", "\"\<,\>\""}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"\"\<for\>\"", "->", "\"\<tract:*\>\""}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"\"\<in\>\"", "->", 
              RowBox[{"\"\<state:\>\"", "<>", 
               RowBox[{"Replace", "[", 
                RowBox[{"state", ",", 
                 RowBox[{"_Entity", ":>", 
