Cell[BoxData[
 RowBox[{
  RowBox[{"logSumExp", "[", "x0_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{"x0", ",", 
        RowBox[{"-", "Infinity"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", "=", 
      RowBox[{"Max", "[", "x", "]"}]}], "}"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "x", "]"}], "==", "1"}], ",", 
      RowBox[{"First", "[", "x", "]"}], ",", 
      RowBox[{"m", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"Total", "@", 
         RowBox[{"Exp", "[", 
          RowBox[{"x", "-", "m"}], "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[485]:=",ExpressionUUID->"7eee9bf5-fd27-4554-b6d3-915d182f3f22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fitZeroOneInflatedBetaBinomialPrior", "[", 
   RowBox[{"super_", ",", "sub_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ll", ",", "\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1", ",", "p2"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ll", "=", 
      RowBox[{"Total", "@", 
       RowBox[{"N", "@", 
        RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"logSumExp", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#2", "==", "0"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"p0", "/", 
                  RowBox[{"(", 
                   RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}], "]"}], ",", 
                
                RowBox[{"-", "Infinity"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#1", "==", "#2"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"p1", "/", 
                  RowBox[{"(", 
                   RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}], "]"}], ",", 
                
                RowBox[{"-", "Infinity"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"p2", "/", 
                 RowBox[{"(", 
                  RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}], "]"}], "+", 
               RowBox[{"betaBinomialLogLikelihood", "[", 
                RowBox[{
                 RowBox[{"BetaBinomialDistribution", "[", 
                  RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "#1"}], "]"}], ",",
                  "#2"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}], 
           "&"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"super", ",", "sub"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1", ",", "p2"}], 
       "}"}], "=", 
      RowBox[{"NArgMax", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"ll", ",", "\[IndentingNewLine]", 
          RowBox[{"0", "<", "\[Alpha]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"0", "<", "\[Beta]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"0", "<=", "p0", "<=", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{"0", "<=", "p1", "<=", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{"0", "<=", "p2", "<=", "1"}]}], "\[IndentingNewLine]", 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1", ",", "p2"}], 
         "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<BetaDistribution\>\"", "->", 
        RowBox[{"BetaDistribution", "[", 
         RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<ZeroSpike\>\"", "->", 
        RowBox[{"p0", "/", 
         RowBox[{"(", 
          RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<OneSpike\>\"", "->", 
        RowBox[{"p1", "/", 
         RowBox[{"(", 
          RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<PDF\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", 
          RowBox[{"Evaluate", "@", 
           RowBox[{"PiecewiseExpand", "@", 
            RowBox[{"Piecewise", "[", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"p0", "/", 
                    RowBox[{"(", 
                    RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}], "*", 
                   RowBox[{"DiracDelta", "[", "x", "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"p2", "/", 
                    RowBox[{"(", 
                    RowBox[{"p0", "+", "p1", "+", "p2"}], ")"}]}], "*", 
                   RowBox[{"PDF", "[", 
                    RowBox[{
                    RowBox[{"BetaDistribution", "[", 
                    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], ",", "x"}], 
                    "]"}]}]}], ",", 
                 RowBox[{"x", "==", "0"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"p1", "/", 
