Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"figDir", ",", "\"\<empDist2.pdf\>\""}], "}"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Echo", "@", 
     RowBox[{"Show", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{"N", "@", "cvap"}], "/", "vap"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"0", "-", 
             RowBox[{"0.05", "/", "2"}]}], ",", 
            RowBox[{"1", "+", 
             RowBox[{"0.05", "/", "2"}]}], ",", "0.05"}], "}"}], 
          ",", "\"\<PDF\>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Omega]\), \(t\)]\) \
(citizenship rate)\>\"", ",", "\"\<pdf\>\""}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotLabel", "->", "\"\<Georgia (Hispanic or Latino)\>\""}],
           ",", "\[IndentingNewLine]", 
          RowBox[{"ImageSize", "->", "250"}]}], "\[IndentingNewLine]", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Plot", "[", 
         RowBox[{
