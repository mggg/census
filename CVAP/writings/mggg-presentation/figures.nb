Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"figDir", ",", "\"\<state_1year_ACS_dec_alignment.pdf\>\""}], 
      "}"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Echo", "@", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"years", "=", 
         RowBox[{"{", 
          RowBox[{
          "2018", ",", "2019", ",", "2021", ",", "2022", ",", "2023"}], 
          "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"y", ",", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"state", ",", "p"}], "}"}], ",", 
                RowBox[{"Tooltip", "[", 
                 RowBox[{"p", ",", 
                  RowBox[{"{", 
                   RowBox[{"state", ",", "y"}], "}"}]}], "]"}]}], "]"}], ",", 
              
              RowBox[{"getScatterPoints", "[", "y", "]"}]}], "]"}]}], "]"}], "/@",
           "years"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Dashed", ",", 
            RowBox[{"InfiniteLine", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1300"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1300"}], "}"}]}], "}"}]}], ","}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<ACS N(B01001A_001E) - N(B01001H_001E)\>\"", 
            ",", "\"\<Decennial N(P1_003N) - N(P2_005N)\>\""}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{"years", ",", 
            RowBox[{"{", 
             RowBox[{"Right", ",", "Top"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"#", ">=", "2020"}], ",", "StandardBlue", ",", 
               "StandardRed"}], "]"}], "&"}], "/@", "years"}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ImageSize", "->", "350"}]}], "\[IndentingNewLine]", "]"}]}],
       "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Background", "->", "Transparent"}]}], "\[IndentingNewLine]", 
