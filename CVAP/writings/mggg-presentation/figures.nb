Cell[CellGroupData[{

Cell["Citizenship rate distributions", "Section",ExpressionUUID->"5c20aa65-768c-457b-a109-15b5784f9f65"],

Cell[CellGroupData[{

Cell["Init", "Subsection",ExpressionUUID->"60c9f179-eb03-4d59-abbc-3c48d18463c4"],

Cell["Set the Census API key", "Text",ExpressionUUID->"bae08727-5af5-45af-a505-9497dcc005ad"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"SystemCredential", "[", "\"\<USCensusAPIKey\>\"", "]"}], 
   "=", "\"\<your Census API key\>\""}], "*)"}]], "Input",
 CellLabel->
  "In[272]:=",ExpressionUUID->"55e0e44f-7941-4ff7-b25b-b3a022e5cb2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "censusQuery", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Authentication", ":>", 
      RowBox[{"SystemCredential", "[", "\"\<USCensusAPIKey\>\"", "]"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"\"\<APIBase\>\"", "->", "\"\<api.census.gov\>\""}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.922479911547374*^9, 3.922479929606248*^9}, {
   3.9224800492421618`*^9, 3.922480062096148*^9}, 3.92248026029036*^9, {
   3.922538194005389*^9, 3.922538202913189*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"d8eecde1-c87a-4d52-b843-88fb41f1f8f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"censusQuery", "[", 
   RowBox[{"path_", ",", "query_", ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Enclose", "@", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rawResponse", ",", "responseList"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rawResponse", "=", 
       RowBox[{"Confirm", "@", 
        RowBox[{"URLRead", "@", 
         RowBox[{"HTTPRequest", "[", 
          RowBox[{"<|", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\"\<Scheme\>\"", "->", "\"\<HTTPS\>\""}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<Domain\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<APIBase\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<Path\>\"", "->", "path"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<Query\>\"", "->", 
             RowBox[{"Join", "[", "\[IndentingNewLine]", 
