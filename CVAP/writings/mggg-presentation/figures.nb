Cell[BoxData[
 RowBox[{
  RowBox[{"vap", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"year", "=", "\"\<2022\>\""}], ",", 
       RowBox[{"state", "=", 
        TemplateBox[{"\"Georgia, United States\"", 
