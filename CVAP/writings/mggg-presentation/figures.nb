Cell["Slope over time", "Subsection",ExpressionUUID->"d374b1e7-e333-44bb-9f15-faf6ce6a94ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"getScatterPoints", "[", "year_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pathACS", ",", "stateCountsACS", ",", "stateCountsDec"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pathACS", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<data\>\"", ",", 
        RowBox[{"ToString", "[", "year", "]"}], ",", "\"\<acs\>\"", 
        ",", "\"\<acs1\>\""}], "}"}]}], ";", "\n", 
     RowBox[{"stateCountsACS", "=", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"allStateValues", "[", 
        RowBox[{
         RowBox[{"{", "\"\<B01001A_001E\>\"", "}"}], ",", "pathACS"}], "]"}], 
       "-", "\[IndentingNewLine]", 
       RowBox[{"allStateValues", "[", 
        RowBox[{
         RowBox[{"{", "\"\<B01001H_001E\>\"", "}"}], ",", "pathACS"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"stateCountsDec", "=", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"allStateValues", "[", 
        RowBox[{
         RowBox[{"{", "\"\<P1_003N\>\"", "}"}], ",", "pathDec"}], "]"}], "-", 
       "\[IndentingNewLine]", 
       RowBox[{"allStateValues", "[", 
        RowBox[{
         RowBox[{"{", "\"\<P2_005N\>\"", "}"}], ",", "pathDec"}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"KeyMap", "[", 
      RowBox[{"fipsStates", ",", 
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"stateCountsACS", ",", "stateCountsDec"}], "}"}], ",", 
         "Identity"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[608]:=",ExpressionUUID->"c05ff530-a8bc-40b2-bdd3-aa08a8404055"],

