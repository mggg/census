Cell["\<\
Their distributions are different too. The ACS has far more zero inflation, \
but also has a fatter tail:\
\>", "Text",ExpressionUUID->"f85e18d3-7a08-4ee1-9c08-e836750fd0b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"tractCountsACS", ",", "\[IndentingNewLine]", "tractCountsDec"}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", "10", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ChartLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<ACS\>\"", ",", "\"\<Decennial\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<non-hispanic white alone population\>\"", 
      ",", "\"\<# of tracts\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"ad57c2de-aa02-4f76-9fe1-6d4333211ec6"],

