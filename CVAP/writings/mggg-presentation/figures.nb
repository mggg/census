     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rawResponse", "=", 
       RowBox[{"Confirm", "@", 
        RowBox[{"URLRead", "@", 
         RowBox[{"HTTPRequest", "[", 
          RowBox[{"<|", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\"\<Scheme\>\"", "->", "\"\<HTTPS\>\""}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<Domain\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<APIBase\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<Path\>\"", "->", "path"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<Query\>\"", "->", 
             RowBox[{"Join", "[", "\[IndentingNewLine]", 
              RowBox[{"query", ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<key\>\"", "->", 
                 RowBox[{"OptionValue", "[", "Authentication", "]"}]}], 
                "}"}]}], "\[IndentingNewLine]", "]"}]}]}], 
           "\[IndentingNewLine]", "|>"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"responseList", "=", 
       RowBox[{"Confirm", "@", 
        RowBox[{"Import", "[", 
         RowBox[{"rawResponse", ",", "\"\<RawJSON\>\""}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ToTabular", "[", 
       RowBox[{
        RowBox[{"Rest", "@", "responseList"}], ",", "\"\<Rows\>\"", ",", 
        RowBox[{"<|", 
         RowBox[{"\"\<ColumnKeys\>\"", "->", 
          RowBox[{"First", "@", "responseList"}]}], "|>"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellLabel->
  "In[586]:=",ExpressionUUID->"fe3bb9ea-6369-43e7-b378-10bf701ee86b"],

Cell["Get tract-level estimates for a variable:", "Text",ExpressionUUID->"3f1b2544-6069-437c-b7e1-e13a0640b395"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tractValues", "[", 
   RowBox[{"vars_", ",", "fipsCode_", ",", "path_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tab", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tab", "=", 
      RowBox[{"censusQuery", "[", "\[IndentingNewLine]", 
       RowBox[{"path", ",", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<get\>\"", "->", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"vars", ",", "\"\<,\>\""}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<for\>\"", "->", "\"\<tract:*\>\""}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<in\>\"", "->", 
           RowBox[{"\"\<state:\>\"", "<>", "fipsCode"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<in\>\"", "->", "\"\<county:*\>\""}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tab", "=", 
      RowBox[{"ConstructColumns", "[", 
       RowBox[{"tab", ",", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<geoid\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"#state", "<>", "#county", "<>", "#tract"}], "]"}]}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"\"\<total\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"Total", "@", 
             RowBox[{"ToExpression", "@", 
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "vars"}], "]"}]}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GroupBy", "[", 
      RowBox[{
       RowBox[{"FromTabular", "[", 
        RowBox[{"tab", ",", "\"\<Rows\>\""}], "]"}], ",", 
       RowBox[{
        RowBox[{"Lookup", "[", "\"\<geoid\>\"", "]"}], "->", 
        RowBox[{"Lookup", "[", "\"\<total\>\"", "]"}]}], ",", "First"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[587]:=",ExpressionUUID->"4759870a-1d76-4621-97de-24bb54f22a1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"allStateValues", "[", 
   RowBox[{"vars_", ",", "path_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tab", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tab", "=", 
      RowBox[{"censusQuery", "[", "\[IndentingNewLine]", 
       RowBox[{"path", ",", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<get\>\"", "->", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"vars", ",", "\"\<,\>\""}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<for\>\"", "->", "\"\<state:*\>\""}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tab", "=", 
      RowBox[{"ConstructColumns", "[", 
       RowBox[{"tab", ",", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<geoid\>\"", "->", 
           RowBox[{"Function", "[", "#state", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<total\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"Total", "@", 
             RowBox[{"ToExpression", "@", 
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "vars"}], "]"}]}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GroupBy", "[", 
      RowBox[{
       RowBox[{"FromTabular", "[", 
        RowBox[{"tab", ",", "\"\<Rows\>\""}], "]"}], ",", 
       RowBox[{
        RowBox[{"Lookup", "[", "\"\<geoid\>\"", "]"}], "->", 
        RowBox[{"Lookup", "[", "\"\<total\>\"", "]"}]}], ",", "First"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[588]:=",ExpressionUUID->"da124de4-271d-4451-9559-76840cffb008"]
}, Closed]],

Cell[CellGroupData[{

Cell["Comparison", "Subsection",ExpressionUUID->"dd1bcf9c-d9c8-42a1-8245-0be1a4a46a13"],

Cell["\<\
We compute the number of Hispanic White alone people in each tract in Georgia \
using data from the 5 year ACS (2022 vintage) and the 2020 Decennial Census.\
\>", "Text",ExpressionUUID->"44c7f907-637e-4b82-aaea-5621dd7f49cc"],

Cell["\<\
For each, we first get the number of White alone people using the following \
variables:\
\>", "Text",ExpressionUUID->"16ebc4a8-edaf-4af0-b31e-d1dcc9981b60"],

Cell[TextData[{
 StyleBox["ACS",
  FontWeight->"Bold"],
 ": B01001A_001E (\"Estimate!!Total:\" from \"Sex by Age (White Alone)\")"
}], "Item",ExpressionUUID->"aaed4324-4434-4156-913b-0b9549e32c76"],

Cell[TextData[{
 StyleBox["Decennial Census",
  FontWeight->"Bold"],
 ": P1_003N (\"!!Total:!!Population of one race:!!White alone\")"
}], "Item",ExpressionUUID->"1b2e7851-ef2b-4717-9c4b-90439cccee1c"],

Cell["\<\
We then get the number of non-Hispanic White alone people using the following \
variables:\
\>", "Text",ExpressionUUID->"578ba3e4-7b6d-4c88-8d7c-45e27ff8ea68"],

Cell[TextData[{
 StyleBox["ACS",
  FontWeight->"Bold"],
 ": B01001H_001E (\"Estimate!!Total:\" from \"Sex by Age (White Alone, Not \
Hispanic or Latino)\")"
}], "Item",ExpressionUUID->"0e6a93c2-f82b-4d5a-a6a6-7103b9f1075e"],

Cell[TextData[{
 StyleBox["Decennial Census",
  FontWeight->"Bold"],
 ": P2_005N (\"!!Total:!!Not Hispanic or Latino:!!Population of one \
race:!!White alone\")"
}], "Item",ExpressionUUID->"17472b34-8efe-4dd2-8d65-1350db1dc90b"],

Cell["Compute the estimates:", "Text",ExpressionUUID->"3e469ee2-9824-40d7-b61a-d65309f1218a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pathACS", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<data\>\"", ",", "\"\<2022\>\"", ",", "\"\<acs\>\"", 
     ",", "\"\<acs5\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pathDec", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<data\>\"", ",", "\"\<2020\>\"", ",", "\"\<dec\>\"", 
     ",", "\"\<pl\>\""}], "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[589]:=",ExpressionUUID->"2ae8e1a2-1516-4227-aa73-edcd29038235"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fipsCode", "=", 
  RowBox[{
   TemplateBox[{"\"Georgia, United States\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"AdministrativeDivision\"", ",", 
         RowBox[{"{", 
           RowBox[{"\"Georgia\"", ",", "\"UnitedStates\""}], "}"}]}], "]"}], 
     "\"Entity[\\\"AdministrativeDivision\\\", {\\\"Georgia\\\", \
\\\"UnitedStates\\\"}]\"", "\"administrative division\""},
    "Entity"], "[", 
   TemplateBox[{"\"FIPS code\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"AdministrativeDivision\"", ",", "\"FIPSCode\""}], "]"}], 
     "\"EntityProperty[\\\"AdministrativeDivision\\\", \\\"FIPSCode\\\"]\""},
    "EntityProperty"], "]"}]}]], "Input",
 CellLabel->
  "In[591]:=",ExpressionUUID->"d9cffd28-3e79-43d3-a32d-fd75cf5c4c87"],

Cell[BoxData["\<\"13\"\>"], "Output",
 CellLabel->
  "Out[591]=",ExpressionUUID->"cb10e94b-ebf8-40f4-ae3a-e365c96697a2"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tractCountsACS", "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tractValues", "[", 
     RowBox[{
      RowBox[{"{", "\"\<B01001A_001E\>\"", "}"}], ",", "fipsCode", ",", 
      "pathACS"}], "]"}], "-", "\[IndentingNewLine]", 
    RowBox[{"tractValues", "[", 
     RowBox[{
      RowBox[{"{", "\"\<B01001H_001E\>\"", "}"}], ",", "fipsCode", ",", 
      "pathACS"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tractCountsDec", "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tractValues", "[", 
     RowBox[{
      RowBox[{"{", "\"\<P1_003N\>\"", "}"}], ",", "fipsCode", ",", 
      "pathDec"}], "]"}], "-", "\[IndentingNewLine]", 
    RowBox[{"tractValues", "[", 
     RowBox[{
      RowBox[{"{", "\"\<P2_005N\>\"", "}"}], ",", "fipsCode", ",", 
      "pathDec"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[594]:=",ExpressionUUID->"73a4082e-3e2a-4fa1-9762-9d5e1b582c21"],

Cell["\<\
The results are very different from the ACS and Decennial Census:\
\>", "Text",ExpressionUUID->"2491a428-d1c9-4df0-8fd1-953debc6c822"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"figDir", ",", "\"\<tract_ACS_dec_alignment.pdf\>\""}], "}"}], 
     "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Echo", "@", 
     RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Values", "@", 
        RowBox[{"Merge", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tractCountsACS", ",", "tractCountsDec"}], "}"}], ",", 
          "Identity"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed", ",", 
          RowBox[{"InfiniteLine", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"AspectRatio", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1300"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1300"}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<ACS N(B01001A_001E) - N(B01001H_001E)\>\"", 
          ",", "\"\<Decennial N(P1_003N) - N(P2_005N)\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "->", "350"}]}], "\[IndentingNewLine]", "]"}]}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"Background", "->", "Transparent"}]}], "\[IndentingNewLine]", 
   "]"}], ";"}]], "Input",
 CellLabel->
  "In[612]:=",ExpressionUUID->"4e22b155-2287-41e3-8cd4-ac3be2b2df15"],

