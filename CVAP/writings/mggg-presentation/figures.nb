Cell[BoxData[
 RowBox[{
  RowBox[{"Export", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"figDir", ",", "\"\<citizenship_pop_hists.pdf\>\""}], "}"}], 
     "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Echo", "@", 
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"vap", ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Transpose", "@", 
             RowBox[{"{", 
              RowBox[{"cvap", ",", "vap"}], "}"}]}], ",", 
            RowBox[{"Apply", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "==", "#2"}], "&&", 
               RowBox[{"#1", ">", "0"}]}], "&"}], "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
        "}"}], ",", "100", ",", "\"\<PDF\>\"", ",", "\[IndentingNewLine]", 
       RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<voting-age population (VAP)\>\"", ",", "\"\<pdf\>\""}], 
         "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ChartLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<all tracts\>\"", 
            ",", "\"\<tracts with full citizenship\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Right", ",", "Top"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "->", "300"}]}], "\[IndentingNewLine]", "]"}]}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"Background", "->", "Transparent"}]}], "\[IndentingNewLine]", 
   "]"}], ";"}]], "Input",
 CellLabel->
  "In[565]:=",ExpressionUUID->"5456a514-6242-4eff-aed6-c62e6fcdf2ef"],

