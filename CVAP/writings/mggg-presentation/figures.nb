       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"All", ",", "#"}], "]"}], "&"}], "/@", "vars"}], 
        "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
