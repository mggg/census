Cell[BoxData[
 RowBox[{
  RowBox[{"stateValue", "[", 
   RowBox[{"vars_", ",", "fipsCode_", ",", "path_"}], "]"}], ":=", 
  RowBox[{"Total", "@", 
   RowBox[{"ToExpression", "@", 
    RowBox[{"Normal", "@", 
     RowBox[{
      RowBox[{"censusQuery", "[", 
       RowBox[{"path", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<get\>\"", "->", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"vars", ",", "\"\<,\>\""}], "]"}]}], ",", 
          RowBox[{"\"\<for\>\"", "->", 
           RowBox[{"\"\<state:\>\"", "<>", "fipsCode"}]}]}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "vars"}], "]"}], "]"}]}]}]}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"7861259d-186a-4333-aa0c-6abf53888327"],

