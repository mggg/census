                   RowBox[{"#1", "==", "#2"}], ",", 
                   RowBox[{"Log", "[", "p1", "]"}], ",", 
                   RowBox[{"-", "Infinity"}]}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Log", "[", 
                   RowBox[{"1", "-", "p0", "-", "p1"}], "]"}], "+", 
                  RowBox[{"betaBinomialLogLikelihood", "[", 
                   RowBox[{
                    RowBox[{"BetaBinomialDistribution", "[", 
                    RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "#1"}], "]"}], ",",
                     "#2"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}], 
              "&"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"super", ",", "sub"}], "}"}]}], "\[IndentingNewLine]", 
            "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1"}], "}"}], "=", 
       RowBox[{"NArgMax", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ll", "[", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1"}], "]"}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"0", "<", "\[Alpha]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"0", "<", "\[Beta]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"0", "<=", "p0", "<=", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{"0", "<=", "p1", "<=", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"p0", "+", "p1"}], "<=", "1"}]}], "\[IndentingNewLine]", 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1"}], "}"}]}],
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<BetaDistribution\>\"", "->", 
         RowBox[{"BetaDistribution", "[", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<ZeroSpike\>\"", "->", "p0"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<OneSpike\>\"", "->", "p1"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"\"\<PDF\>\"", "->", 
