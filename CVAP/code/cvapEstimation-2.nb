Cell[BoxData[
 RowBox[{
  RowBox[{"vap", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"year", "=", "\"\<2022\>\""}], ",", 
       RowBox[{"state", "=", 
        TemplateBox[{"\"Georgia, United States\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"AdministrativeDivision\"", ",", 
              RowBox[{"{", 
                RowBox[{"\"Georgia\"", ",", "\"UnitedStates\""}], "}"}]}], 
            "]"}], "\"Entity[\\\"AdministrativeDivision\\\", \
{\\\"Georgia\\\", \\\"UnitedStates\\\"}]\"", "\"administrative division\""},
         "Entity"]}], ",", "vars", ",", "t"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"getVAPVarsACS", "[", "\"\<HispanicOrLatino\>\"", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"t", "=", 
       RowBox[{"CastColumns", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"censusQuery", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<data\>\"", ",", "year", ",", "\"\<acs\>\"", 
             ",", "\"\<acs5\>\""}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\"\<get\>\"", "->", 
              RowBox[{"StringRiffle", "[", 
               RowBox[{"vars", ",", "\"\<,\>\""}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"\"\<for\>\"", "->", "\"\<tract:*\>\""}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"\"\<in\>\"", "->", 
              RowBox[{"\"\<state:\>\"", "<>", 
               RowBox[{"Replace", "[", 
                RowBox[{"state", ",", 
                 RowBox[{"_Entity", ":>", 
                  RowBox[{"state", "[", "\"\<FIPSCode\>\"", "]"}]}]}], 
                "]"}]}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"\"\<in\>\"", "->", "\"\<county:*\>\""}]}], 
            "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"vars", "->", "\"\<Integer\>\""}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Normal", "@", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"All", ",", "#"}], "]"}], "&"}], "/@", "vars"}], 
        "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"f721d5f2-1fc0-4242-a40f-68dcb60543a6"],

