                    RowBox[{
                    RowBox[{"BetaDistribution", "[", 
                    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], ",", "x"}], 
                    "]"}]}]}], ",", 
                 RowBox[{"x", "==", "0"}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
