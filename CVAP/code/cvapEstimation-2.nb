                  RowBox[{"PDF", "[", 
                   RowBox[{
                    RowBox[{"BetaDistribution", "[", 
                    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], ",", "x"}], 
                   "]"}]}], ",", "True"}], "}"}]}], "\[IndentingNewLine]", 
