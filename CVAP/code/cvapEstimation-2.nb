Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"fitZeroOneInflatedBetaBinomialPrior", "[", 
    RowBox[{"super_", ",", "sub_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "x", ",", "isZero", ",", "isFull", ",", "logBinom", ",", "ll",
        ",", "la", ",", "lb", ",", "u1", ",", "u2", ",", "z"}], "}"}], ",", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"N", "[", "super", "]"}]}], ";", 
      RowBox[{"x", "=", 
       RowBox[{"N", "[", "sub", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"isZero", "=", 
       RowBox[{"1", "-", 
        RowBox[{"Unitize", "[", "sub", "]"}]}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"1", " ", "where", " ", "sub"}], "==", "0"}], "*)"}], 
      RowBox[{"isFull", "=", 
       RowBox[{"1", "-", 
        RowBox[{"Unitize", "[", 
         RowBox[{"sub", "-", "super"}], "]"}]}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"1", " ", "where", " ", "sub"}], "==", "super"}], "*)"}], 
      RowBox[{"logBinom", "=", 
       RowBox[{
        RowBox[{"LogGamma", "[", 
         RowBox[{"n", "+", "1"}], "]"}], "-", 
        RowBox[{"LogGamma", "[", 
         RowBox[{"x", "+", "1"}], "]"}], "-", 
        RowBox[{"LogGamma", "[", 
         RowBox[{"n", "-", "x", "+", "1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ll", "[", 
        RowBox[{
         RowBox[{"la_", "?", "NumericQ"}], ",", 
         RowBox[{"lb_", "?", "NumericQ"}], ",", 
         RowBox[{"u1_", "?", "NumericQ"}], ",", 
         RowBox[{"u2_", "?", "NumericQ"}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "=", 
            RowBox[{"Exp", "[", "la", "]"}]}], ",", 
           RowBox[{"b", "=", 
            RowBox[{"Exp", "[", "lb", "]"}]}], ",", 
           RowBox[{"zz", "=", 
            RowBox[{"1", "+", 
             RowBox[{"Exp", "[", "u1", "]"}], "+", 
             RowBox[{"Exp", "[", "u2", "]"}]}]}], ",", "q0", ",", "q1", ",", 
           "q2", ",", "bb"}], "}"}], ",", 
         RowBox[{
          RowBox[{"q0", "=", 
           RowBox[{"1", "/", "zz"}]}], ";", 
          RowBox[{"q1", "=", 
           RowBox[{
            RowBox[{"Exp", "[", "u1", "]"}], "/", "zz"}]}], ";", 
          RowBox[{"q2", "=", 
           RowBox[{
            RowBox[{"Exp", "[", "u2", "]"}], "/", "zz"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bb", "=", 
           RowBox[{"logBinom", "-", 
            RowBox[{"LogGamma", "[", "a", "]"}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{"x", "+", "a"}], "]"}], "-", 
            RowBox[{"LogGamma", "[", "b", "]"}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{"n", "-", "x", "+", "b"}], "]"}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{"a", "+", "b"}], "]"}], "-", 
            RowBox[{"LogGamma", "[", 
             RowBox[{"n", "+", "a", "+", "b"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Total", "[", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"isZero", " ", "q0"}], "+", 
             RowBox[{"isFull", " ", "q1"}], "+", 
             RowBox[{"q2", " ", 
              RowBox[{"Exp", "[", "bb", "]"}]}]}], "]"}], "]"}]}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"la", ",", "lb", ",", "u1", ",", "u2"}], "}"}], "=", 
       RowBox[{"NArgMax", "[", 
        RowBox[{
         RowBox[{"ll", "[", 
          RowBox[{"la", ",", "lb", ",", "u1", ",", "u2"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"la", ",", "lb", ",", "u1", ",", "u2"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"z", "=", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", "u1", "]"}], "+", 
        RowBox[{"Exp", "[", "u2", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<alpha\>\"", "->", 
         RowBox[{"Exp", "[", "la", "]"}]}], ",", 
        RowBox[{"\"\<beta\>\"", "->", 
         RowBox[{"Exp", "[", "lb", "]"}]}], ",", 
        RowBox[{"\"\<p0\>\"", "->", 
         RowBox[{"1", "/", "z"}]}], ",", 
        RowBox[{"\"\<p1\>\"", "->", 
         RowBox[{
          RowBox[{"Exp", "[", "u1", "]"}], "/", "z"}]}], ",", 
        RowBox[{"\"\<p2\>\"", "->", 
         RowBox[{
          RowBox[{"Exp", "[", "u2", "]"}], "/", "z"}]}]}], "|>"}]}]}], 
    "]"}]}], "*)"}]], "Input",ExpressionUUID->"c2e26ff1-6916-4b4d-bf9d-\
f97dda1dcde1"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"fitZeroOneInflatedBetaBinomialPrior", "[", 
    RowBox[{"super_", ",", "sub_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ll", ",", "\[Alpha]", ",", "\[Beta]", ",", "p0", ",", "p1", ",", "x"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ll", "[", 
        RowBox[{
         RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
         RowBox[{"\[Beta]_", "?", "NumericQ"}], ",", 
         RowBox[{"p0_", "?", "NumericQ"}], ",", 
         RowBox[{"p1_", "?", "NumericQ"}]}], "]"}], ":=", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"0", "<", "\[Alpha]"}], "&&", 
            RowBox[{"0", "<", "\[Beta]"}], "&&", 
            RowBox[{"0", "<=", "p0"}], "&&", 
            RowBox[{"0", "<=", "p1"}], "&&", 
            RowBox[{
             RowBox[{"p0", "+", "p1"}], "<=", "1"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"-", "$MaxMachineNumber"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Total", "@", 
          RowBox[{"N", "@", 
           RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"logSumExp", "[", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"#2", "==", "0"}], ",", 
                   RowBox[{"Log", "[", "p0", "]"}], ",", 
                   RowBox[{"-", "Infinity"}]}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
