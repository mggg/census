Cell[BoxData[
 RowBox[{
  RowBox[{"getVAPStatePUMSRaw", "[", "fipsCode_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"censusQuery", "[", "\[IndentingNewLine]", 
   RowBox[{"pathPUMS", ",", "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<get\>\"", "->", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{"varsPUMS", ",", "\"\<,\>\""}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<for\>\"", "->", 
       RowBox[{"\"\<state:\>\"", "<>", "fipsCode"}]}]}], 
