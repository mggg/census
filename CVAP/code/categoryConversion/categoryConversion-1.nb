Cell[CellGroupData[{

Cell["Min-max", "Subsection",ExpressionUUID->"59809f8d-e366-4acf-b249-f7357f31bbc3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"solMin", "=", 
    RowBox[{"ConvexOptimization", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Inactive", "[", "Total", "]"}], "[", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Inactive", "[", "Subtract", "]"}], "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Inactive", "[", "Times", "]"}], "[", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "6"}], "]"}], "]"}], ",", "x"}], "]"}], ",",
           "y"}], "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"x", "\[Element]", "NonNegativeIntegers"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Method", "\[Rule]", "\"\<MOSEK\>\""}]}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "//", "EchoTiming"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"87965598-a4a3-450a-9b55-7f8040114250"],

Cell[BoxData["0.068321`"], "EchoTiming",ExpressionUUID->"bb8c7059-4296-4257-8677-3909fc50e0f8"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"xRangeAt", "[", 
   RowBox[{"a_", ",", "y_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "obj", ",", "sol", ",", "opt", ",", "minSol", ",", "maxSol"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{
       RowBox[{"Dimensions", "[", "a", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"obj", "=", 
      RowBox[{"Total", "@", 
       RowBox[{"Abs", "@", 
        RowBox[{
         RowBox[{"Inactive", "[", "Subtract", "]"}], "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Inactive", "[", "Dot", "]"}], "[", 
           RowBox[{"a", ",", "x"}], "]"}], ",", "y"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"ConvexOptimization", "[", 
       RowBox[{"obj", ",", 
        RowBox[{"{", "}"}], ",", 
        RowBox[{"x", "\[Element]", 
         RowBox[{"Vectors", "[", 
          RowBox[{"n", ",", "NonNegativeIntegers"}], "]"}]}], ",", 
        RowBox[{"Method", "->", "\"\<MOSEK\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Echo", "[", "\"\<solved main\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"opt", "=", 
      RowBox[{"Activate", "[", 
       RowBox[{"obj", "/.", "sol"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Echo", "[", "opt", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"minSol", "=", 
      RowBox[{"Echo", "@", 
       RowBox[{"ConvexOptimization", "[", 
        RowBox[{
         RowBox[{"Indexed", "[", 
          RowBox[{"x", ",", "k"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"obj", "==", "opt"}], "}"}], ",", 
         RowBox[{"x", "\[Element]", 
          RowBox[{"Vectors", "[", 
           RowBox[{"n", ",", "NonNegativeIntegers"}], "]"}]}], ",", 
         RowBox[{"Method", "->", "\"\<MOSEK\>\""}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxSol", "=", 
      RowBox[{"Echo", "@", 
       RowBox[{"ConvexOptimization", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Indexed", "[", 
           RowBox[{"x", ",", "k"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"obj", "==", "opt"}], "}"}], ",", 
         RowBox[{"x", "\[Element]", 
          RowBox[{"Vectors", "[", 
           RowBox[{"n", ",", "NonNegativeIntegers"}], "]"}]}], ",", 
         RowBox[{"Method", "->", "\"\<MOSEK\>\""}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<OptimalObjectiveValue\>\"", "->", "opt"}], ",", 
       RowBox[{"\"\<Min\>\"", "->", 
        RowBox[{"Activate", "[", 
         RowBox[{"obj", "/.", "minSol"}], "]"}]}], ",", 
       RowBox[{"\"\<Max\>\"", "->", 
        RowBox[{"-", 
         RowBox[{"Activate", "[", 
          RowBox[{"obj", "/.", "maxSol"}], "]"}]}]}], ",", 
       RowBox[{"\"\<MinSolution\>\"", "->", "minSol"}], ",", 
       RowBox[{"\"\<MaxSolution\>\"", "->", "maxSol"}]}], "|>"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"437683b9-a7a9-4a2c-8603-c7787557dc70"],

